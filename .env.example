DATABASE_URL="postgresql://user:password@localhost:5432/emr"
BETTER_AUTH_SECRET="<random 32+ char secret>"
BETTER_AUTH_URL="http://localhost:3000"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/emr_test"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<store-id>_<secret>"

# Logo used throughout the app: dhathri-ayurvedic (default), dhathri-gram, or none
LOGIN_LOGO_VARIANT=dhathri-ayurvedic

# Optional auth links (hidden unless explicitly set to true)
AUTH_SHOW_CREATE_WORKSPACE_LINK=false
AUTH_SHOW_BACK_TO_SITE_LINK=false

# Restrict the sidebar to the Appointment Dashboard and booking dependencies (set false for the full menu)
SIDEBAR_APPOINTMENTS_ONLY=true

# Show Visits and Reports in the reduced sidebar when the user has Visit permission
SIDEBAR_SHOW_VISITS=false

# Sign out of the app after this many minutes of inactivity (warning shown 60 seconds before; must be over 1)
IDLE_TIMEOUT_MINUTES=10

# Enable the static-data demo pages: Visit List, Billing Counter, and Clinician assessment.
# Keep false in production; these pages show made-up Patients and Invoices.
ENABLE_DEMO_PAGES=false

# Product analytics (PostHog). Off unless ANALYTICS_ENABLED=true and a project key is set.
# Use a separate PostHog project, or leave it off, for non-production deployments. See docs/analytics.md.
ANALYTICS_ENABLED=false
POSTHOG_PROJECT_KEY="phc_<project-api-key>"
# PostHog Cloud EU ingestion host (the default)
POSTHOG_HOST="https://eu.i.posthog.com"
