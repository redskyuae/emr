DATABASE_URL="postgresql://user:password@localhost:5432/emr"
BETTER_AUTH_SECRET="<random 32+ char secret>"
BETTER_AUTH_URL="http://localhost:3000"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/emr_test"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<store-id>_<secret>"

# Logo used throughout the app: dhathri-ayurvedic (default), dhathri-gram, or none
LOGIN_LOGO_VARIANT=dhathri-ayurvedic

# Optional auth links (hidden unless explicitly set to true)
AUTH_SHOW_CREATE_WORKSPACE_LINK=false
AUTH_SHOW_BACK_TO_SITE_LINK=false

# Restrict the sidebar to the Appointment Dashboard and booking dependencies (set false for the full menu)
SIDEBAR_APPOINTMENTS_ONLY=true
